# =============================================================================
#                                   Oh-My-Zsh
# =============================================================================

export PATH="/opt/homebrew/bin:$PATH" # Important to load homebrew firstly because next lines need homebrew to install.
export ZSH="$HOME/.oh-my-zsh"
eval "$(oh-my-posh init zsh)" # THEME

# Oh-My-Zsh settings
DISABLE_AUTO_UPDATE="true"
COMPLETION_WAITING_DOTS="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"
HIST_STAMPS="yyyy-mm-dd"


# =============================================================================
#                                   Plugins
# =============================================================================

# Plugins are lazy-loaded with zsh-defer: the prompt is drawn first, then
# _zshrc_deferred runs while the shell waits for the first keystroke.

# HOMEBREW_PREFIX comes from `brew shellenv` in ~/.zprofile; avoid spawning `brew --prefix`.
HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
plugins=(
    git                     # Git integration
    docker                  # Docker commands
    poetry                  # Python package manager
    fzf                     # Fuzzy finder
)
fpath=($fpath ~/.zsh/completion)
# Docker CLI completions. Added before Oh-My-Zsh so its single compinit picks them up.
fpath=("$HOME/.docker/completions" $fpath)
# History settings must exist when .zshrc returns, because zsh loads the history file then.
source $ZSH/lib/history.zsh
# zsh-defer runs tasks with local options, so Oh-My-Zsh's setopt calls would be undone.
# These are the options its lib/ sets.
setopt always_to_end auto_cd auto_pushd complete_in_word interactive_comments long_list_jobs pushd_ignore_dups pushd_minus
unsetopt flow_control

function _zshrc_deferred() {
    # Keep our aliases over Oh-My-Zsh plugin aliases (e.g. git's `gl`).
    local user_aliases=$(alias -L)
    source $ZSH/oh-my-zsh.sh
    eval $user_aliases
    # Vi mode must load after Oh-My-Zsh, whose key-bindings.zsh switches to emacs keys.
    ZVM_INIT_MODE=sourcing
    source $HOMEBREW_PREFIX/opt/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh # Vi mode on terminal
    source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh # Command suggestions
    # Setting ag as the default source for fzf
    [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
    eval "$(zoxide init zsh)"
    # Shell command completion for gcloud.
    if [ -f '/Users/lexuancuong/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/lexuancuong/google-cloud-sdk/completion.zsh.inc'; fi
    # Must be sourced last.
    source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh # Syntax highlighting
}

# Defer only when a line editor will wait for input; `zsh -i -c` (editors, tools
# snapshotting the shell) and a missing zsh-defer load everything immediately.
if [[ -z $ZSH_EXECUTION_STRING && -o zle && -f $ZSH/custom/plugins/zsh-defer/zsh-defer.plugin.zsh ]]; then
    source $ZSH/custom/plugins/zsh-defer/zsh-defer.plugin.zsh
    zsh-defer _zshrc_deferred
else
    _zshrc_deferred
fi

