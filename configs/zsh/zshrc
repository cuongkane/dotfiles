#                                   Functions
# =============================================================================

# Prefer a project's local virtualenv for Python tools, including commands run
# by Git hooks that inherit PATH. Walk upwards so this also works in subfolders.
autoload -Uz add-zsh-hook
typeset -g PROJECT_VENV_BIN=''

function sync_project_venv_path() {
    if [[ -n "$PROJECT_VENV_BIN" ]]; then
        path=("${(@)path:#$PROJECT_VENV_BIN}")
        PROJECT_VENV_BIN=''
    fi

    local project_dir="$PWD"
    while [[ "$project_dir" != "/" ]]; do
        if [[ -d "$project_dir/.venv/bin" ]]; then
            PROJECT_VENV_BIN="$project_dir/.venv/bin"
            path=("$PROJECT_VENV_BIN" $path)
            return
        fi
        project_dir="${project_dir:h}"
    done
}

add-zsh-hook chpwd sync_project_venv_path
sync_project_venv_path

